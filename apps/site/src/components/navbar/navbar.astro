---
import Dropdown from "./dropdown.astro";
import LanguageSwitcher from "./language-switcher.astro";
import { Icon } from "astro-icon/components";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { getLocalizedPath, getSiteLocale, siteCopy } from "@/i18n";

const locale = getSiteLocale(Astro.url.pathname);
const copy = siteCopy[locale].nav;
const menuitems = [
  {
    title: copy.features,
    path: `${getLocalizedPath(locale, "/")}#features`,
  },
  {
    title: copy.deploy,
    path: getLocalizedPath(locale, "/blog/ai-agent-deploy-cloudflare"),
  },
  {
    title: copy.guides,
    children: [
      {
        title: copy.evernoteMigration,
        path: getLocalizedPath(locale, "/blog/evernote-migration-guide"),
      },
      {
        title: copy.memosMigration,
        path: getLocalizedPath(locale, "/blog/memos-migration-guide"),
      },
      {
        title: copy.notionMigration,
        path: getLocalizedPath(locale, "/blog/notion-migration-guide"),
      },
      {
        title: copy.advancedPlay,
        path: getLocalizedPath(locale, "/guides/advanced-play"),
      },
    ],
  },
  {
    title: copy.blog,
    path: getLocalizedPath(locale, "/blog"),
  },
];
---

<header class="sticky top-3 md:top-4 z-50 max-w-5xl mx-auto px-4">
  <div class="relative rounded-full border border-slate-200/90 bg-white/85 backdrop-blur-md shadow-xs transition-all duration-300 hover:shadow-md hover:border-slate-300/90 px-4 py-2">
    <Astronav>
      <div class="flex items-center justify-between">
        <!-- Logo Left -->
        <a href={getLocalizedPath(locale, "/")} class="flex items-center gap-2 text-base select-none" aria-label={copy.homeAria}>
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-[var(--edgeever-brand-logo-bg)] shadow-xs">
            <svg class="h-5 w-5" viewBox="0 0 64 64" role="img" aria-hidden="true">
              <rect x="14" y="10" width="36" height="44" rx="8" fill="var(--edgeever-brand-logo-mark)" />
              <path d="M24 23h18v5H30v5h11v5H30v6h13v5H24V23Z" fill="var(--edgeever-brand-surface)" />
              <path d="M19 16h26" stroke="var(--edgeever-brand-logo-accent)" stroke-width="3" stroke-linecap="round" />
            </svg>
          </span>
          <span class="font-bold text-slate-800 tracking-tight text-sm md:text-base">
            Edge<span class="text-emerald-700">Ever</span>
          </span>
        </a>

        <!-- Desktop Navigation Items Center -->
        <MenuItems class="hidden lg:flex items-center gap-1">
          <ul class="flex items-center gap-1">
            {
              menuitems.map((item, index) => (
                <>
                  {item.children && (
                    <Dropdown
                      title={item.title}
                      children={item.children}
                      lastItem={index === menuitems.length - 1}
                    />
                  )}

                  {!item.children && (
                    <li>
                      <a
                        href={item.path}
                        class="px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-emerald-700 hover:bg-emerald-50/60 rounded-full transition-all duration-200"
                      >
                        <span>{item.title}</span>
                      </a>
                    </li>
                  )}
                </>
              ))
            }
          </ul>
        </MenuItems>

        <!-- Right Side Actions: Language Switcher & Open Source GitHub Button -->
        <div class="hidden lg:flex items-center gap-3">
          <LanguageSwitcher pathname={Astro.url.pathname} />
          <a
            href="https://github.com/tianma-if/edgeever"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-emerald-700 bg-white hover:bg-emerald-50/50 border border-slate-200/90 hover:border-emerald-400 rounded-full transition-all duration-200 shadow-2xs"
            aria-label="GitHub"
          >
            <Icon class="h-4 w-4 text-slate-800" name="bx:bxl-github" />
            <span>{copy.openSource}</span>
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <div class="flex items-center gap-2 lg:hidden">
          <LanguageSwitcher pathname={Astro.url.pathname} compact />
          <MenuIcon class="w-5 h-5 text-slate-700 cursor-pointer p-0.5 rounded-md hover:bg-slate-100 transition-colors" />
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <MenuItems class="hidden w-full lg:hidden pt-3 pb-2 border-t border-slate-100 mt-2">
        <ul class="flex flex-col gap-1">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="block px-3 py-2 text-xs font-semibold text-slate-600 hover:text-emerald-700 hover:bg-emerald-50/60 rounded-xl transition-all"
                    >
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
        <div class="flex items-center mt-3 pt-2 border-t border-slate-100 gap-3">
          <a
            href="https://github.com/tianma-if/edgeever"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-200 rounded-full"
            aria-label="GitHub"
          >
            <Icon class="h-4 w-4 text-slate-800" name="bx:bxl-github" />
            <span>{copy.openSource}</span>
          </a>
        </div>
      </MenuItems>
    </Astronav>
  </div>
</header>
