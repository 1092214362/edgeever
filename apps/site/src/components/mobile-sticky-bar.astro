---
import { getLocalizedPath, getSiteLocale, siteCopy } from "@/i18n";
import { Icon } from "astro-icon/components";

const locale = getSiteLocale(Astro.url.pathname);
const copy = siteCopy[locale].hero;
---

<!-- Mobile Floating Bottom Action Bar (Appears on Mobile Scroll) -->
<div
  id="mobile-sticky-bar"
  class="fixed bottom-4 left-4 right-4 z-40 sm:hidden transition-all duration-300 transform translate-y-20 opacity-0 pointer-events-none"
>
  <div class="flex items-center justify-between p-2 pl-3.5 rounded-full border border-slate-200/90 bg-white/95 backdrop-blur-lg shadow-xl border-slate-100">
    <a href={getLocalizedPath(locale, "/")} class="flex items-center gap-1.5 shrink-0">
      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-[var(--edgeever-brand-logo-bg)] shadow-2xs">
        <svg class="h-4 w-4" viewBox="0 0 64 64" role="img" aria-hidden="true">
          <rect x="14" y="10" width="36" height="44" rx="8" fill="var(--edgeever-brand-logo-mark)" />
          <path d="M24 23h18v5H30v5h11v5H30v6h13v5H24V23Z" fill="var(--edgeever-brand-surface)" />
          <path d="M19 16h26" stroke="var(--edgeever-brand-logo-accent)" stroke-width="3" stroke-linecap="round" />
        </svg>
      </span>
      <span class="font-bold text-slate-900 text-xs tracking-tight">EdgeEver</span>
    </a>

    <div class="flex items-center gap-1.5">
      <a
        href="https://demo.edgeever.org"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1 px-3 py-1.5 text-[11px] font-bold text-white bg-brand rounded-full shadow-xs active:scale-95 transition-transform"
      >
        <Icon name="bx:bx-show" class="w-3.5 h-3.5" />
        <span>{copy.demo}</span>
      </a>
      <a
        href={getLocalizedPath(locale, "/blog/ai-agent-deploy-cloudflare")}
        class="inline-flex items-center gap-1 px-3 py-1.5 text-[11px] font-bold text-brand-text bg-emerald-50 border border-emerald-200/80 rounded-full active:scale-95 transition-transform"
      >
        <Icon name="simple-icons:cloudflare" class="w-3 h-3 text-emerald-600" />
        <span>{copy.agentInstall}</span>
      </a>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById("mobile-sticky-bar");
    if (!bar) return;

    window.addEventListener("scroll", function () {
      if (window.scrollY > 320) {
        bar.classList.remove("translate-y-20", "opacity-0", "pointer-events-none");
        bar.classList.add("translate-y-0", "opacity-100");
      } else {
        bar.classList.add("translate-y-20", "opacity-0", "pointer-events-none");
        bar.classList.remove("translate-y-0", "opacity-100");
      }
    }, { passive: true });
  })();
</script>
